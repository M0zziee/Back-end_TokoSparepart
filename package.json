{
  "name": "backend-toko",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check": "tsc",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" src/server.ts",
    "migrate": "node --env-file-if-exists=.env migrations/run.ts",
    "create-user": "node --env-file-if-exists=.env scripts/create-user.ts",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  }
}
